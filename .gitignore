# Build output
/bin/
/dist/
# Anchored: an unanchored "clerk" would also match the cmd/clerk/ directory.
/clerk

# Local runtime state (SQLite DB, signing keys)
/data/
/keys/
*.db
*.db-shm
*.db-wal

# Private key material. The keys directory above is already ignored; this is
# the backstop against one being generated anywhere else in the tree.
*.pem

# Local environment
.env
.env.local

# Test output
coverage.out
*.test

# End-to-end suite
/e2e/node_modules/
/e2e/test-results/
/e2e/playwright-report/
