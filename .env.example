# Clerk settings.
#
# Copy this file to .env and fill in the values:
#
#   cp .env.example .env
#
# Rules: one KEY=value per line, no quotes, no spaces around "=".
# Lines that start with # are ignored. Never commit your .env file.

# --- Required -----------------------------------------------------------------

# The public address of Clerk, exactly as browsers and applications reach it.
ISSUER=http://localhost:8080

# Where Clerk can reach Bouncer, and the API key Bouncer issued for Clerk.
BOUNCER_URL=http://host.docker.internal:3000
BOUNCER_API_KEY=bncr_replace_me

# At least one admin sign-in provider (both the ID and the secret).
# Register this callback URL at the provider, exactly:
#   <ISSUER>/admin/auth/google/callback
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me

# --- Other admin sign-in providers (optional) ---------------------------------
# Callback URL: <ISSUER>/admin/auth/<provider>/callback

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Only for a single-tenant Microsoft app:
# MICROSOFT_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# --- Optional (the values shown are the defaults) -----------------------------

# The role (its customId in Bouncer) an administrator must have.
# BOUNCER_REQUIRED_ROLE=admin

# LISTEN_ADDR=:8080
# DB_PATH=/data/clerk.db
# KEYS_PATH=/keys/signing.pem

# How long codes and tokens are valid. Examples: 30s, 5m, 1h. Minimum 1s.
# CODE_TTL=1m
# ACCESS_TOKEN_TTL=1h
# ID_TOKEN_TTL=1h
